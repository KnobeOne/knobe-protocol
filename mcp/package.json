{
  "name": "knobe-mcp",
  "version": "0.1.0",
  "description": "MCP server for KNOBE Protocol v1: verify, read, create, and transform sealed .knobe.md knowledge objects, and evaluate what their sealed terms permit. Runs locally; no telemetry.",
  "type": "module",
  "bin": {
    "knobe-mcp": "server.mjs"
  },
  "main": "server.mjs",
  "files": [
    "server.mjs",
    "knobe-core.js",
    "README.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "David Kyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnobeOne/knobe-protocol.git",
    "directory": "mcp"
  },
  "homepage": "https://knobe.org",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "knobe",
    "provenance",
    "integrity",
    "knowledge-objects"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
